stat_qq() +
stat_qq_line(color = "red") +
facet_wrap(~name, scales = "free") +
theme_minimal() +
labs(title = "QQ Plots for Numeric Variables")
#Normality tests (For large n, Shapiro is often significant even for mild deviations.)
apply(num_vars, 2, function(x) shapiro.test(x)$p.value)
#(if Shapiro test is sig < 0.05, then we fail to reject the null hypothesis that the data is deviated from the normal distribution)
#Normality tests (For large n, Shapiro is often significant even for mild deviations.)
apply(num_vars, 2, function(x) shapiro.test(x)$p.value)
tobacco$diseased_num <- as.numeric(as.factor(tobacco$diseased)) - 1
View(tobacco)
cor(tobacco$diseased_num, num_vars, use = "complete.obs")
# then the categorical variables
cat_vars <- tobacco %>% select(where(is.factor), where(is.character))
cat_vars %>%
pivot_longer(everything()) %>%
ggplot(aes(x = value)) +
geom_bar(fill = "darkgreen") +
facet_wrap(~name, scales = "free_x") +
theme_minimal() +
labs(title = "Categorical Variable Counts", x = "", y = "Count") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
View(cat_vars)
ggplot(tobacco, aes(x = smoker, fill = diseased)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
theme_minimal() +
labs(title = "Disease Status by Smoking",
y = "Proportion", x = "Smoker")
# Correlation analysis (numeric)
cor_mat <- cor(num_vars, use = "complete.obs")
corrplot(cor_mat, method = "color", type = "upper",
tl.cex = 0.8, number.cex = 0.7)
freq(tobacco$disease,
report.nas = FALSE,
totals     = FALSE,
cumul      = FALSE,
headings   = FALSE)
# Or multiple frequency tables At Once
freq(tobacco)
freq(tobacco$disease,
order    = "freq",
rows     = 1:5,
headings = FALSE)
#4-Cross-Tabulations:
# ctable() generates cross-tabulations (joint frequencies) for pairs of categorical variables.
ctable(x = tobacco$smoker,
y = tobacco$diseased,
prop = "r")   # Show row proportions
#4-Cross-Tabulations:
# ctable() generates cross-tabulations (joint frequencies) for pairs of categorical variables.
ctable(x = tobacco$smoker,
y = tobacco$diseased,
prop = "r")   # Show row proportions
ctable(x = tobacco$smoker,
y = tobacco$diseased,
chisq = TRUE,
OR    = TRUE,
RR    = TRUE,
headings = FALSE,
method = "render")
stby(
list(
x = tobacco$smoker, # smoker and diseased
y = tobacco$diseased
),
INDICES = tobacco$gender, # for each gender
FUN = ctable # ctable for cross-tabulation
)
view(dfSummary(tobacco))
